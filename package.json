{
  "name": "mfg_portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd frontend && vite",
    "build": "cd frontend && vite build --base=/assets/mfg_portal/frontend/ && cd .. && yarn copy-html-entry",
    "preview": "cd frontend && vite preview",
    "copy-html-entry": "mkdir -p mfg_portal/www && cp mfg_portal/public/frontend/index.html mfg_portal/www/mfg_portal.html"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "frappe-react-sdk": "^1.17.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.4.5",
    "react-hot-toast": "^2.6.1",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "oxlint": "^1.81.0"
  }
}
